includes:
	- vendor/phpstan/phpstan-mockery/extension.neon
	# Errors that existed when PHPStan was added to CI. Fix them over time and
	# regenerate with: vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
	- phpstan-baseline.neon

parameters:
	level: 9
	paths:
		- cli
		- tests
	ignoreErrors:
		- '#Method .*? with no value type specified in iterable type array#'
	# Fixed errors and newer dependencies can leave baseline entries unused;
	# that should not fail the build.
	reportUnmatchedIgnoredErrors: false
